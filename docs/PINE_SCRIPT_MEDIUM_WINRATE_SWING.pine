//@version=6
indicator("Medium Win Rate Swing Strategy", overlay=true)

// ========================================
// MEDIUM WIN RATE SWING (50-60% win rate)
// ========================================
// Strategy: Trend continuation with pullbacks
// - Trade with HTF trend
// - Enter on pullbacks to key levels
// - Moderate stops
// - Target 2-4R
// - Balanced frequency
// - Best for trending markets

// Inputs
emaFast = input.int(21, "Fast EMA")
emaSlow = input.int(55, "Slow EMA")
lookbackSwing = input.int(50, "Swing High/Low Lookback")
fibLevel = input.float(0.618, "Fibonacci Retracement Level")
atrLength = input.int(14, "ATR Length")
volumeMultiplier = input.float(1.2, "Volume Multiplier")

// Calculate indicators
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
sma200 = ta.sma(close, 200)
atr = ta.atr(atrLength)

// Trend identification
bullishTrend = emaF > emaS and close > sma200
bearishTrend = emaF < emaS and close < sma200
htfBias = bullishTrend ? "bullish" : bearishTrend ? "bearish" : "neutral"

// Swing highs and lows
swingHigh = ta.highest(high, lookbackSwing)
swingLow = ta.lowest(low, lookbackSwing)

// Fibonacci retracement levels
swingRange = swingHigh - swingLow
fibLevelLong = swingHigh - (swingRange * fibLevel)  // 61.8% retracement for longs
fibLevelShort = swingLow + (swingRange * fibLevel)  // 61.8% retracement for shorts

// Volume confirmation
avgVolume = ta.sma(volume, 20)
volumeSpike = volume > avgVolume * volumeMultiplier

// Session detection
isNY = hour >= 9 and hour < 16
isLondon = hour >= 3 and hour < 11
currentSession = isNY ? "NY" : isLondon ? "LONDON" : "ASIA"

// Previous day levels
pdHigh = request.security(syminfo.tickerid, "D", high[1])
pdLow = request.security(syminfo.tickerid, "D", low[1])

// ===== LONG SWING SETUP =====
// Conditions:
// 1. In bullish trend (price above 200 SMA, EMAs aligned)
// 2. Price pulled back to Fib level or EMA
// 3. Bullish reversal candle (hammer, engulfing)
// 4. Volume increasing on reversal
atFibSupport = close <= fibLevelLong and close >= fibLevelLong * 0.98
atEmaSupport = math.abs(close - emaF) / close < 0.005  // Within 0.5% of EMA
bullishReversal = close > open and (close - open) > (high - low) * 0.6  // Strong green candle

longSwingSetup = bullishTrend and
                  (atFibSupport or atEmaSupport) and
                  bullishReversal and
                  volumeSpike

// ===== SHORT SWING SETUP =====
// Conditions:
// 1. In bearish trend (price below 200 SMA, EMAs aligned)
// 2. Price rallied to Fib level or EMA
// 3. Bearish reversal candle (shooting star, engulfing)
// 4. Volume increasing on reversal
atFibResistance = close >= fibLevelShort and close <= fibLevelShort * 1.02
atEmaResistance = math.abs(close - emaF) / close < 0.005  // Within 0.5% of EMA
bearishReversal = close < open and (open - close) > (high - low) * 0.6  // Strong red candle

shortSwingSetup = bearishTrend and
                   (atFibResistance or atEmaResistance) and
                   bearishReversal and
                   volumeSpike

// Displacement detection
displacement = (high - low) > atr * 1.2
displacementDetected = displacement

// Webhook alerts
if longSwingSetup and (isNY or isLondon)
    alert(str.format('{"symbol": "%s", "timeframe": "%s", "event": "swing_long", "session": "%s", "price": %f, "previousDayHigh": %f, "previousDayLow": %f, "volumeSpike": %s, "displacementDetected": %s, "htfBias": "%s"}',
          syminfo.ticker, timeframe.period, currentSession, close, pdHigh, pdLow,
          str.tostring(volumeSpike), str.tostring(displacementDetected), htfBias),
          alert.freq_once_per_bar)

if shortSwingSetup and (isNY or isLondon)
    alert(str.format('{"symbol": "%s", "timeframe": "%s", "event": "swing_short", "session": "%s", "price": %f, "previousDayHigh": %f, "previousDayLow": %f, "volumeSpike": %s, "displacementDetected": %s, "htfBias": "%s"}',
          syminfo.ticker, timeframe.period, currentSession, close, pdHigh, pdLow,
          str.tostring(volumeSpike), str.tostring(displacementDetected), htfBias),
          alert.freq_once_per_bar)

// Visual markers
plotshape(longSwingSetup, "Long Swing", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(shortSwingSetup, "Short Swing", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// Plot EMAs
plot(emaF, "Fast EMA", color.blue, linewidth=2)
plot(emaS, "Slow EMA", color.orange, linewidth=2)
plot(sma200, "200 SMA", color.gray, linewidth=1)

// Plot Fib levels
plot(fibLevelLong, "Fib Long", color.new(color.green, 70), linewidth=1, style=plot.style_circles)
plot(fibLevelShort, "Fib Short", color.new(color.red, 70), linewidth=1, style=plot.style_circles)

// Trend background
bgcolor(bullishTrend ? color.new(color.green, 95) : bearishTrend ? color.new(color.red, 95) : na)

// ========================================
// STRATEGY NOTES
// ========================================
// Expected Performance:
// - Win Rate: 50-60%
// - Average R:R: 1:2 to 1:4
// - Trades per day: 1-3 (moderate frequency)
// - Best timeframes: 15m, 1h, 4h
//
// Risk Management:
// - Stop: Below swing low / above swing high (~1-2% risk)
// - Target: Previous swing high/low (2-4R)
// - Trail stops after 1:1 achieved
//
// Strengths:
// + Balanced win rate and R:R
// + Less stressful than scalping
// + Good for part-time traders
// + Works in trending markets
//
// Weaknesses:
// - Requires patience for pullbacks
// - Moderate drawdowns possible
// - Needs clear trend identification
//
// Use When:
// - Clear trend is established
// - Market has structure (swing highs/lows)
// - HTF trend aligns with entry
