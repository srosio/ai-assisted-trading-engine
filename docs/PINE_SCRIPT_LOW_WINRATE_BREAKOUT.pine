//@version=6
indicator("Low Win Rate Breakout Strategy", overlay=true)

// ========================================
// LOW WIN RATE / HIGH R:R BREAKOUT (30-40% win rate)
// ========================================
// Strategy: Breakout trading with momentum
// - Trade range breakouts
// - Wide stops (accepts more losses)
// - Large targets (5-10R)
// - Low frequency
// - Best for explosive moves
// - Requires strong psychology

// Inputs
rangeLength = input.int(50, "Range Period")
breakoutThreshold = input.float(1.5, "Breakout ATR Multiplier")
volumeMultiplier = input.float(2.0, "Volume Surge Multiplier")
consolidationBars = input.int(20, "Minimum Consolidation Bars")
atrLength = input.int(14, "ATR Length")

// Calculate indicators
atr = ta.atr(atrLength)
sma200 = ta.sma(close, 200)

// Range identification
rangeHigh = ta.highest(high, rangeLength)
rangeLow = ta.lowest(low, rangeLength)
rangeSize = rangeHigh - rangeLow
rangeMiddle = (rangeHigh + rangeLow) / 2

// Consolidation detection (tight range = coiling)
atr14 = ta.atr(14)
atr50 = ta.atr(50)
consolidating = atr14 < atr50 * 0.7  // ATR compressed

// Count consolidation bars
var int consolidationCount = 0
if consolidating
    consolidationCount += 1
else
    consolidationCount := 0

// Volume analysis
avgVolume = ta.sma(volume, 50)
volumeSurge = volume > avgVolume * volumeMultiplier

// HTF bias
htfBias = close > sma200 ? "bullish" : close < sma200 ? "bearish" : "neutral"

// Session detection
isNY = hour >= 9 and hour < 16
isLondon = hour >= 3 and hour < 11
currentSession = isNY ? "NY" : isLondon ? "LONDON" : "ASIA"

// Previous day levels
pdHigh = request.security(syminfo.tickerid, "D", high[1])
pdLow = request.security(syminfo.tickerid, "D", low[1])

// ===== BULLISH BREAKOUT SETUP =====
// Conditions:
// 1. Price consolidating near range high
// 2. Breaks above range high with momentum
// 3. Massive volume surge
// 4. Strong displacement candle
// 5. Ideally aligns with HTF trend

// Near range high (within 10%)
nearRangeHigh = high >= rangeHigh * 0.9

// Breakout confirmation
breakoutLong = close > rangeHigh and
               (close - open) > atr * breakoutThreshold and
               volumeSurge and
               consolidationCount >= consolidationBars

// Strong displacement
strongDisplacement = (high - low) > atr * 2.0

longBreakoutSetup = breakoutLong and strongDisplacement

// ===== BEARISH BREAKOUT SETUP =====
// Conditions:
// 1. Price consolidating near range low
// 2. Breaks below range low with momentum
// 3. Massive volume surge
// 4. Strong displacement candle
// 5. Ideally aligns with HTF trend

// Near range low (within 10%)
nearRangeLow = low <= rangeLow * 1.1

// Breakout confirmation
breakoutShort = close < rangeLow and
                (open - close) > atr * breakoutThreshold and
                volumeSurge and
                consolidationCount >= consolidationBars

shortBreakoutSetup = breakoutShort and strongDisplacement

// Displacement detection
displacementDetected = strongDisplacement

// Webhook alerts
if longBreakoutSetup and (isNY or isLondon)
    alert(str.format('{"symbol": "%s", "timeframe": "%s", "event": "breakout_long", "session": "%s", "price": %f, "previousDayHigh": %f, "previousDayLow": %f, "volumeSpike": %s, "displacementDetected": %s, "htfBias": "%s"}',
          syminfo.ticker, timeframe.period, currentSession, close, pdHigh, pdLow,
          str.tostring(volumeSurge), str.tostring(displacementDetected), htfBias),
          alert.freq_once_per_bar)

if shortBreakoutSetup and (isNY or isLondon)
    alert(str.format('{"symbol": "%s", "timeframe": "%s", "event": "breakout_short", "session": "%s", "price": %f, "previousDayHigh": %f, "previousDayLow": %f, "volumeSpike": %s, "displacementDetected": %s, "htfBias": "%s"}',
          syminfo.ticker, timeframe.period, currentSession, close, pdHigh, pdLow,
          str.tostring(volumeSurge), str.tostring(displacementDetected), htfBias),
          alert.freq_once_per_bar)

// Visual markers
plotshape(longBreakoutSetup, "Breakout Long", shape.diamond, location.belowbar, color.new(color.lime, 0), size=size.normal)
plotshape(shortBreakoutSetup, "Breakout Short", shape.diamond, location.abovebar, color.new(color.fuchsia, 0), size=size.normal)

// Plot range
plot(rangeHigh, "Range High", color.red, linewidth=2, style=plot.style_stepline)
plot(rangeLow, "Range Low", color.green, linewidth=2, style=plot.style_stepline)
plot(rangeMiddle, "Range Middle", color.gray, linewidth=1, style=plot.style_circles)

// Consolidation background
bgcolor(consolidating and consolidationCount >= consolidationBars ? color.new(color.yellow, 90) : na, title="Coiling")

// Volume bars
plot(volumeSurge ? 1 : 0, "Volume Surge", color.orange, 3, plot.style_histogram)

// ========================================
// STRATEGY NOTES
// ========================================
// Expected Performance:
// - Win Rate: 30-40%
// - Average R:R: 1:5 to 1:10+
// - Trades per day: 0-1 (very selective)
// - Best timeframes: 1h, 4h, Daily
//
// Risk Management:
// - Stop: Inside range or below consolidation (~2-3% risk)
// - Target: Extension beyond range (5-10R+)
// - Let winners run (trail stop after 3R)
//
// Strengths:
// + Huge winners when right
// + One winner can cover many losses
// + Less screen time required
// + Catches explosive moves
//
// Weaknesses:
// - Many small losses
// - Requires strong discipline
// - Psychologically challenging
// - Long wait between signals
// - Many false breakouts
//
// Use When:
// - Market has been consolidating
// - Clear range is established
// - Anticipating major catalyst/news
// - Volume is compressing (coiling)
//
// Psychology:
// - Accept that most trades will lose
// - Focus on process, not individual trades
// - Size positions to handle streak of losses
// - Stay patient for the big move
//
// Risk of Ruin:
// - CRITICAL: Must have large account relative to risk
// - 10+ losing trades in a row is normal
// - Calculate max drawdown before starting
// - Only for experienced traders
