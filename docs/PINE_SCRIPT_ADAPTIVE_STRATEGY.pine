//@version=6
indicator("Adaptive Market Strategy", overlay=true)

// ========================================
// ADAPTIVE STRATEGY (40-60% win rate)
// ========================================
// Strategy: Adapts based on market conditions
// - Identifies market regime (trending vs ranging)
// - Uses different tactics per regime
// - Dynamic R:R targets
// - All-weather approach
// - Best for consistent performance

// Inputs
atrLength = input.int(14, "ATR Length")
adxLength = input.int(14, "ADX Length")
adxThreshold = input.int(25, "ADX Trend Threshold")
volumeMultiplier = input.float(1.3, "Volume Multiplier")
emaFast = input.int(21, "Fast EMA")
emaSlow = input.int(55, "Slow EMA")

// Calculate core indicators
atr = ta.atr(atrLength)
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
sma200 = ta.sma(close, 200)

// ADX for trend strength
[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)

// Market regime identification
isTrending = adx > adxThreshold
isRanging = adx <= adxThreshold

// Trend direction
bullishTrend = emaF > emaS and close > sma200
bearishTrend = emaF < emaS and close < sma200
htfBias = bullishTrend ? "bullish" : bearishTrend ? "bearish" : "neutral"

// Volume analysis
avgVolume = ta.sma(volume, 20)
volumeConfirmed = volume > avgVolume * volumeMultiplier

// Bollinger Bands for ranging markets
[bbMiddle, bbUpper, bbLower] = ta.bb(close, 20, 2.0)

// Session detection
isNY = hour >= 9 and hour < 16
isLondon = hour >= 3 and hour < 11
currentSession = isNY ? "NY" : isLondon ? "LONDON" : "ASIA"

// Previous day levels
pdHigh = request.security(syminfo.tickerid, "D", high[1])
pdLow = request.security(syminfo.tickerid, "D", low[1])

// ===== TRENDING MARKET TACTICS =====
// When ADX > 25: Trend following with pullbacks
trendLongSetup = isTrending and
                  bullishTrend and
                  close < emaF and close > emaF * 0.99 and  // Pullback to EMA
                  close > open and  // Bullish reversal
                  volumeConfirmed

trendShortSetup = isTrending and
                   bearishTrend and
                   close > emaF and close < emaF * 1.01 and  // Pullback to EMA
                   close < open and  // Bearish reversal
                   volumeConfirmed

// ===== RANGING MARKET TACTICS =====
// When ADX < 25: Mean reversion at extremes
rangeLongSetup = isRanging and
                  close <= bbLower and  // Oversold
                  close > open and  // Reversal candle
                  volumeConfirmed

rangeShortSetup = isRanging and
                   close >= bbUpper and  // Overbought
                   close < open and  // Reversal candle
                   volumeConfirmed

// ===== COMBINED SIGNALS =====
adaptiveLongSetup = trendLongSetup or rangeLongSetup
adaptiveShortSetup = trendShortSetup or rangeShortSetup

// Signal quality assessment
setupQuality = "B"  // Default

// A quality: Everything aligns
if (trendLongSetup and volumeConfirmed and bullishTrend) or
   (trendShortSetup and volumeConfirmed and bearishTrend)
    setupQuality := "A"

// C quality: Weak conditions
if (rangeLongSetup and not volumeConfirmed) or
   (rangeShortSetup and not volumeConfirmed)
    setupQuality := "C"

// Displacement detection
displacement = (high - low) > atr * 1.2
displacementDetected = displacement

// Event naming based on regime
eventLong = isTrending ? "trend_continuation_long" : "range_bounce_long"
eventShort = isTrending ? "trend_continuation_short" : "range_bounce_short"

// Webhook alerts
if adaptiveLongSetup and (isNY or isLondon)
    alert(str.format('{"symbol": "%s", "timeframe": "%s", "event": "%s", "session": "%s", "price": %f, "previousDayHigh": %f, "previousDayLow": %f, "volumeSpike": %s, "displacementDetected": %s, "htfBias": "%s", "marketRegime": "%s", "setupQuality": "%s"}',
          syminfo.ticker, timeframe.period, eventLong, currentSession, close, pdHigh, pdLow,
          str.tostring(volumeConfirmed), str.tostring(displacementDetected), htfBias,
          isTrending ? "TRENDING" : "RANGING", setupQuality),
          alert.freq_once_per_bar)

if adaptiveShortSetup and (isNY or isLondon)
    alert(str.format('{"symbol": "%s", "timeframe": "%s", "event": "%s", "session": "%s", "price": %f, "previousDayHigh": %f, "previousDayLow": %f, "volumeSpike": %s, "displacementDetected": %s, "htfBias": "%s", "marketRegime": "%s", "setupQuality": "%s"}',
          syminfo.ticker, timeframe.period, eventShort, currentSession, close, pdHigh, pdLow,
          str.tostring(volumeConfirmed), str.tostring(displacementDetected), htfBias,
          isTrending ? "TRENDING" : "RANGING", setupQuality),
          alert.freq_once_per_bar)

// Visual markers
plotshape(trendLongSetup, "Trend Long", shape.triangleup, location.belowbar, color.new(color.lime, 0), size=size.small)
plotshape(trendShortSetup, "Trend Short", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)
plotshape(rangeLongSetup, "Range Long", shape.circle, location.belowbar, color.new(color.blue, 30), size=size.tiny)
plotshape(rangeShortSetup, "Range Short", shape.circle, location.abovebar, color.new(color.orange, 30), size=size.tiny)

// Plot EMAs
plot(emaF, "Fast EMA", color.blue, linewidth=2)
plot(emaS, "Slow EMA", color.orange, linewidth=2)

// Plot BB for ranging markets
plot(isRanging ? bbUpper : na, "BB Upper", color.gray, linewidth=1)
plot(isRanging ? bbLower : na, "BB Lower", color.gray, linewidth=1)

// Market regime background
bgcolor(isTrending ? (bullishTrend ? color.new(color.green, 95) : bearishTrend ? color.new(color.red, 95) : na) :
        color.new(color.yellow, 95), title="Market Regime")

// ADX strength indicator
plot(adx, "ADX", color.purple, linewidth=1)
hline(adxThreshold, "Trend Threshold", color.gray, linestyle=hline.style_dashed)

// ========================================
// STRATEGY NOTES
// ========================================
// Expected Performance:
// - Win Rate: 40-60% (varies by regime)
// - Average R:R: 1:2 to 1:4
// - Trades per day: 2-5 (moderate)
// - Best timeframes: 15m, 1h
//
// Regime-Specific Approach:
//
// TRENDING MARKETS (ADX > 25):
// - Use trend following tactics
// - Enter on pullbacks to EMA
// - Wider stops, larger targets (3-4R)
// - Higher win rate when trend is strong
//
// RANGING MARKETS (ADX < 25):
// - Use mean reversion tactics
// - Enter at BB extremes
// - Tighter stops, smaller targets (1.5-2R)
// - Quick exits to avoid whipsaws
//
// Risk Management:
// - Trending: Stop beyond last swing (~1.5% risk)
// - Ranging: Stop beyond BB (~0.8% risk)
// - Dynamic targets based on regime
// - Adjust position size per volatility
//
// Strengths:
// + Works in all market conditions
// + Consistent performance over time
// + Less vulnerable to regime changes
// + Balances win rate and R:R
//
// Weaknesses:
// - More complex to understand
// - Requires regime identification skills
// - Moderate drawdowns still possible
// - Not optimized for any single condition
//
// Use When:
// - Market conditions are unclear
// - Want consistent all-weather approach
// - Building long-term track record
// - Don't want to constantly adjust strategy
//
// Psychology:
// - Accept varied results per regime
// - Trust the adaptive process
// - Focus on long-term edge
// - Keep detailed regime-specific stats
