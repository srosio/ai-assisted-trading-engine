//@version=5
indicator("Liquidity Sweep Detector", overlay=true)

// Example Pine Script for detecting liquidity sweeps and sending webhooks
// This is a simplified example - customize for your strategy

// Inputs
lookback = input.int(20, "Lookback Period")
volumeMultiplier = input.float(1.5, "Volume Spike Multiplier")

// Calculate key levels
pdHigh = request.security(syminfo.tickerid, "D", high[1])
pdLow = request.security(syminfo.tickerid, "D", low[1])

// Detect equal highs/lows
equalHighs = ta.valuewhen(high == ta.highest(high, lookback), high, 0)
equalLows = ta.valuewhen(low == ta.lowest(low, lookback), low, 0)

// Volume spike detection
avgVolume = ta.sma(volume, 20)
volumeSpike = volume > avgVolume * volumeMultiplier

// HTF bias (simplified - use your own logic)
htfBias = close > ta.sma(close, 200) ? "bullish" : close < ta.sma(close, 200) ? "bearish" : "neutral"

// Detect liquidity sweep long (price takes lows then reverses)
sweptLow = low < equalLows and close > equalLows
displacementUp = close > open and (high - low) > ta.atr(14) * 1.5

liquiditySweepLong = sweptLow and displacementUp and volumeSpike

// Detect liquidity sweep short (price takes highs then reverses)
sweptHigh = high > equalHighs and close < equalHighs
displacementDown = close < open and (high - low) > ta.atr(14) * 1.5

liquiditySweepShort = sweptHigh and displacementDown and volumeSpike

// Session detection
isNY = hour >= 9 and hour < 16 // NY session (EST)
isLondon = hour >= 3 and hour < 11 // London session (EST)
currentSession = isNY ? "NY" : isLondon ? "LONDON" : "ASIA"

// Webhook alerts
if liquiditySweepLong and (isNY or isLondon)
    alert(str.format('{"symbol": "%s", "timeframe": "%s", "event": "liquidity_sweep_long", "session": "%s", "price": %f, "previous_day_high": %f, "previous_day_low": %f, "volume_spike": true, "displacement_detected": true, "htf_bias": "%s"}',
          syminfo.ticker, timeframe.period, currentSession, close, pdHigh, pdLow, htfBias),
          alert.freq_once_per_bar)

if liquiditySweepShort and (isNY or isLondon)
    alert(str.format('{"symbol": "%s", "timeframe": "%s", "event": "liquidity_sweep_short", "session": "%s", "price": %f, "previous_day_high": %f, "previous_day_low": %f, "volume_spike": true, "displacement_detected": true, "htf_bias": "%s"}',
          syminfo.ticker, timeframe.period, currentSession, close, pdHigh, pdLow, htfBias),
          alert.freq_once_per_bar)

// Visual markers
plotshape(liquiditySweepLong, "Long Setup", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(liquiditySweepShort, "Short Setup", shape.triangledown, location.abovebar, color.red, size=size.small)

// Plot levels
plot(pdHigh, "Previous Day High", color.blue, linewidth=1, style=plot.style_linebr)
plot(pdLow, "Previous Day Low", color.blue, linewidth=1, style=plot.style_linebr)
