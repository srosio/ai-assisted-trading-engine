//@version=6
indicator("High Win Rate Scalping Strategy", overlay=true)

// ============================================================================
// STRATEGY: High Win Rate Scalping (70-80% WR, 1:1-1:2 R:R)
// Identifies mean reversion opportunities at Bollinger Band extremes
// Webhook-integrated with AI-Assisted Trading Engine
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

// Bollinger Bands Settings
bbLength = input.int(20, "BB Length", minval=1)
bbMult = input.float(2.0, "BB StdDev", minval=0.1, step=0.1)

// RSI Settings
rsiLength = input.int(14, "RSI Length", minval=1)
rsiOverbought = input.int(70, "RSI Overbought", minval=50, maxval=100)
rsiOversold = input.int(30, "RSI Oversold", minval=0, maxval=50)

// Volume Spike Detection
volMultiplier = input.float(2.0, "Volume Spike Multiplier", minval=1.0)

// Webhook Settings
webhookUrl = input.string("https://your-app.onrender.com/api/webhook/tradingview?apiKey=YOUR_KEY", "Webhook URL")

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

// Bollinger Bands
[bbMiddle, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)

// RSI
rsi = ta.rsi(close, rsiLength)

// Volume
volSMA = ta.sma(volume, 20)
volumeSpike = volume > volSMA * volMultiplier

// Previous Day High/Low
var float pdHigh = na
var float pdLow = na
if timeframe.change('D')
    pdHigh := high[1]
    pdLow := low[1]

// Session Detection
currentHour = hour(time, "America/New_York")
is_asia = currentHour >= 20 or currentHour < 3
is_london = currentHour >= 3 and currentHour < 8
is_ny = currentHour >= 8 and currentHour < 16

session = is_london ? "LONDON_OPEN" : is_ny ? "NY_OPEN" : is_asia ? "ASIA_OPEN" : "OFF_SESSION"

// HTF Bias (1H timeframe)
htf_ema_fast = request.security(syminfo.tickerid, "60", ta.ema(close, 20))
htf_ema_slow = request.security(syminfo.tickerid, "60", ta.ema(close, 50))
htfBias = htf_ema_fast > htf_ema_slow ? "BULLISH" : htf_ema_fast < htf_ema_slow ? "BEARISH" : "NEUTRAL"

// ─────────────────────────────────────────────────────────────────────────────
// STRATEGY LOGIC
// ─────────────────────────────────────────────────────────────────────────────

// Long Setup: Price at lower BB + RSI oversold
longCondition = close <= bbLower and rsi <= rsiOversold and close > low

// Short Setup: Price at upper BB + RSI overbought
shortCondition = close >= bbUpper and rsi >= rsiOverbought and close < high

// Displacement Detection (strong candle move)
candleRange = high - low
avgRange = ta.sma(candleRange, 14)
displacementDetected = candleRange > avgRange * 1.5

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING
// ─────────────────────────────────────────────────────────────────────────────

plot(bbMiddle, "BB Middle", color=color.blue, linewidth=1)
p1 = plot(bbUpper, "BB Upper", color=color.red, linewidth=1)
p2 = plot(bbLower, "BB Lower", color=color.green, linewidth=1)
fill(p1, p2, color=color.new(color.blue, 95))

plotshape(longCondition, "Long Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS & WEBHOOKS
// ─────────────────────────────────────────────────────────────────────────────

// Long Alert with Webhook Payload
if longCondition
    alert('{"symbol":"' + syminfo.ticker + '", "timeframe":"' + timeframe.period + '", "event":"scalping_long_bb_extreme", "session":"' + session + '", "price":' + str.tostring(close) + ', "previousDayHigh":' + str.tostring(pdHigh) + ', "previousDayLow":' + str.tostring(pdLow) + ', "volumeSpike":' + str.tostring(volumeSpike) + ', "displacementDetected":' + str.tostring(displacementDetected) + ', "sweptHigh":null, "sweptLow":' + str.tostring(bbLower) + ', "htfBias":"' + htfBias + '"}', alert.freq_once_per_bar_close)

// Short Alert with Webhook Payload
if shortCondition
    alert('{"symbol":"' + syminfo.ticker + '", "timeframe":"' + timeframe.period + '", "event":"scalping_short_bb_extreme", "session":"' + session + '", "price":' + str.tostring(close) + ', "previousDayHigh":' + str.tostring(pdHigh) + ', "previousDayLow":' + str.tostring(pdLow) + ', "volumeSpike":' + str.tostring(volumeSpike) + ', "displacementDetected":' + str.tostring(displacementDetected) + ', "sweptHigh":' + str.tostring(bbUpper) + ', "sweptLow":null, "htfBias":"' + htfBias + '"}', alert.freq_once_per_bar_close)
