// Modified by Gemini: Add RSI filter and HMA Turbo

//@version=6
indicator('Candle 2 Closure + RSI', overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// INPUTS
//---------------------------------------------------------------------------------------------------------------------{
GREEN               = #089981
RED                 = #F23645
SILVER              = color.silver
STYLE_GROUP         = 'STYLE'
ALERTS_GROUP        = 'ALERTS'
FILTER_GROUP        = 'ACCURACY FILTERS'

// --- LuxAlgo Inputs ---
candle2Input        = input.bool(true, 'Candle 2 (Reversal)')
candle3Input        = input.bool(true, 'Candle 3 (Expansion)')
reversalFilterInput = input.bool(false, 'Reversals Filter', inline = 'filter')
filterLengthInput   = input.int(20, '', inline = 'filter')
wickPercentInput    = input.int(40, 'Wick Threshold %', tooltip = 'Max wick size as % of candle')

// --- FILTERS ---
useRsiFilter        = input.bool(true, "Use RSI Filter?", group = FILTER_GROUP)
rsiLen              = input.int(14, "RSI Length", group = FILTER_GROUP)
rsiBuyLevel         = input.int(65, "Max RSI for Buy (<)", group = FILTER_GROUP)
rsiSellLevel        = input.int(35, "Min RSI for Sell (>)", group = FILTER_GROUP)
useHmaFilter        = input.bool(true, "Use HMA Trend (HTF Bias)?", group = FILTER_GROUP)
hmaLength           = input.int(55, "HMA Length", group = FILTER_GROUP)

// --- Styling ---
bullishColorInput   = input.color(GREEN, 'Bullish Color', group = STYLE_GROUP)
bearishColorInput   = input.color(RED, 'Bearish Color', group = STYLE_GROUP)
transparencyInput   = input.int(80, 'Transparency', group = STYLE_GROUP, minval = 0, maxval = 100)
levelsInput         = input.bool(true, 'Levels', group = STYLE_GROUP, inline = 'levels')
levelsColorInput    = input.color(SILVER, 'Color', group = STYLE_GROUP, inline = 'levels')
levelsAutoInput     = input.bool(true, 'Auto', group = STYLE_GROUP, inline = 'levels')
candle2ZoneInput    = input.bool(true, 'Candle 2 Zone', group = STYLE_GROUP)
candle3ZoneInput    = input.bool(true, 'Candle 3 Zone', group = STYLE_GROUP)
candle2AlertInput   = input.bool(true, 'Candle 2 Alerts', group = ALERTS_GROUP)
candle3AlertInput   = input.bool(true, 'Candle 3 Alerts', group = ALERTS_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
// CALCULATIONS & HELPER FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
type trigger
    bool active = false
    string direction = "neutral"
    string event_type = "none"
    float swept_level = na
    float price = na
    float sl = na

trigger t2 = trigger.new()
trigger t3 = trigger.new()

var int barMilliseconds = 1000 * timeframe.in_seconds()

// --- 1. Indicators ---
rsiValue = ta.rsi(close, rsiLen)
hmaValue = ta.hma(close, hmaLength)

// --- 2. Determine Session ---
is_asia = not na(time(timeframe.period, "0000-0800:1234567", "UTC"))
is_london = not na(time(timeframe.period, "0700-1600:1234567", "UTC"))
is_ny = not na(time(timeframe.period, "1300-2200:1234567", "UTC"))

get_session() =>
    string s = "Global"
    if is_ny
        s := "New York"
    else if is_london
        s := "London"
    else if is_asia
        s := "Asia"
    s

// --- 3. Determine HTF Bias ---
get_bias() =>
    close > hmaValue ? "bullish" : "bearish"

// --- 4. Universal JSON Generator (FIXED TIME FORMAT) ---
get_json(string _direction, string _eventType, float _price, float _sl, float _sweptLevel, string _htfBias) =>
    string _sess = get_session()

    // Constructing the JSON string
    string json =
      '{' +
      '"symbol": "' + syminfo.ticker + '", ' +
      '"timeframe": "' + timeframe.period + '", ' +
      '"strategy": "Candle_2_Closure", ' +
      '"event_type": "' + _eventType + '", ' +
      '"direction": "' + _direction + '", ' +
      '"session": "' + _sess + '", ' +
      '"price": {' +
          '"close": ' + str.tostring(_price) + ', ' +
          '"stop_loss": ' + str.tostring(_sl) +
      '}, ' +
      '"context": {' +
          '"swept_level": ' + (na(_sweptLevel) ? "null" : str.tostring(_sweptLevel)) + ', ' +
          '"htf_bias": "' + _htfBias + '", ' +
          '"displacement": true' +
      '}, ' +
      '"timestamp": "' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss", "UTC") + '"' +
      '}'
    json

// Conditions
rsiBuyCondition  = not useRsiFilter or (rsiValue < rsiBuyLevel)
rsiSellCondition = not useRsiFilter or (rsiValue > rsiSellLevel)
hmaBuyCondition  = not useHmaFilter or (close > hmaValue)
hmaSellCondition = not useHmaFilter or (close < hmaValue)

plot(useHmaFilter ? hmaValue : na, "HTF Bias (HMA)", color=color.rgb(156, 39, 176), linewidth=2)

//---------------------------------------------------------------------------------------------------------------------}
// LOGIC & PLOTTING
//---------------------------------------------------------------------------------------------------------------------{
drawLevels() =>
    // LuxAlgo Reversal Logic
    bool bullishReversalCloseRaw   = (reversalFilterInput ? low == ta.lowest(filterLengthInput) : true) and close[1] < open[1] and low < low[1] and close > low[1]
    bool bearishReversalCloseRaw   = (reversalFilterInput ? high == ta.highest(filterLengthInput) : true) and close[1] > open[1] and high > high[1] and close < high[1]

    // Apply Filters
    bool bullishReversalClose = bullishReversalCloseRaw and rsiBuyCondition and hmaBuyCondition
    bool bearishReversalClose = bearishReversalCloseRaw and rsiSellCondition and hmaSellCondition

    bool candle2Reversal        = bullishReversalClose or bearishReversalClose
    float wickThreshold         = math.round_to_mintick(0.01*wickPercentInput*(high - low))
    bool bullishBigWick         = (math.min(close,open) - low) > wickThreshold
    bool bearishBigWick         = (high - math.max(close,open)) > wickThreshold
    bool bigWick                = (bullishReversalClose and bullishBigWick) or (bearishBigWick and bearishReversalClose)
    bool bearishExpansion       = bearishReversalClose[1] and high < high[1] and close < low[1]
    bool bullishExpansion       = bullishReversalClose[1] and low > low[1] and close > high[1]
    bool candle3Expansion       = (bearishExpansion or bullishExpansion)

    // --- CANDLE 2 (Main Reversal) ---
    if candle2Reversal and candle2Input
        // Visuals
        label.new(chart.point.new(time,na,bullishReversalClose ? low : high),'2',xloc.bar_time,bullishReversalClose ? yloc.belowbar : yloc.abovebar, color(na), bullishReversalClose ? label.style_label_up : label.style_label_down, bullishReversalClose ? bullishColorInput : bearishColorInput,size.small)

        // Populate Data for JSON
        t2.active := true
        t2.direction := bullishReversalClose ? "bullish" : "bearish"
        t2.event_type := "reversal"
        t2.price := close
        t2.swept_level := bullishReversalClose ? low[1] : high[1]
        t2.sl := bullishReversalClose ? low : high // Suggest SL at recent candle low/high

        if levelsInput
            line.new(chart.point.new(time[1],na,bullishReversalClose ? low[1] : high[1]),chart.point.new(time + barMilliseconds,na,bullishReversalClose ? low[1] : high[1]),xloc.bar_time,color = levelsAutoInput ? chart.fg_color : levelsColorInput)
        if candle2ZoneInput
            float top           = 0.0
            float bottom        = 0.0
            float bodyTop       = math.max(close,open)
            float bodyBottom    = math.min(close,open)
            if bigWick
                top     := bullishReversalClose ? bodyBottom : high - math.round_to_mintick(0.5*(high - bodyTop))
                bottom  := bullishReversalClose ? bodyBottom - math.round_to_mintick(0.5*(bodyBottom - low)) : bodyTop
            else
                top     := bullishReversalClose ? bodyTop : hl2
                bottom  := bullishReversalClose ? hl2 : bodyBottom
            box.new(chart.point.new(time,na,top),chart.point.new(time + barMilliseconds,na,bottom),border_color = color(na),xloc = xloc.bar_time, bgcolor = bullishReversalClose ? color.new(bullishColorInput,transparencyInput) : color.new(bearishColorInput,transparencyInput))

    // --- CANDLE 3 (Expansion/Continuation) ---
    if candle3Expansion and candle3Input
        label.new(chart.point.new(time,na,bullishExpansion ? low : high),'3',xloc.bar_time,bullishExpansion ? yloc.belowbar : yloc.abovebar, color(na), bullishExpansion ? label.style_label_up : label.style_label_down, bullishExpansion ? bullishColorInput : bearishColorInput,size.small)
        t3.active := true
        t3.direction := bullishExpansion ? "bullish" : "bearish"
        t3.event_type := "expansion"
        t3.price := close
        t3.swept_level := na // Expansions don't sweep, they run
        t3.sl := bullishExpansion ? low : high

        if candle3ZoneInput
            float top       = bullishExpansion ? close : hl2
            float bottom    = bullishExpansion ? hl2 : close
            box.new(chart.point.new(time,na,top),chart.point.new(time + barMilliseconds,na,bottom),border_color = color(na),xloc = xloc.bar_time, bgcolor = bullishExpansion ? color.new(bullishColorInput,transparencyInput) : color.new(bearishColorInput,transparencyInput))

//---------------------------------------------------------------------------------------------------------------------}
// EXECUTION & ALERTS
//---------------------------------------------------------------------------------------------------------------------{
drawLevels()

// Get Current HTF Bias from HMA
currentBias = get_bias()

// --- Trigger JSON Alerts ---
if candle2AlertInput and t2.active
    string msg = get_json(t2.direction, t2.event_type, t2.price, t2.sl, t2.swept_level, currentBias)
    alert(msg, alert.freq_once_per_bar_close)

if candle3AlertInput and t3.active
    string msg = get_json(t3.direction, t3.event_type, t3.price, t3.sl, t3.swept_level, currentBias)
    alert(msg, alert.freq_once_per_bar_close)