[Unit]
Description=AI-Assisted Crypto Trading Engine
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/ai-trading-engine

# Java application command
ExecStart=/usr/bin/java \
    -Xms512m \
    -Xmx1024m \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -Dspring.profiles.active=production \
    -jar /opt/ai-trading-engine/ai-assisted-trading-engine.jar

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-trading-engine

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ai-trading-engine/logs
ReadWritePaths=/var/log/ai-trading-engine

# Environment variables (sensitive values should be in environment file)
EnvironmentFile=-/etc/ai-trading-engine/environment

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
