# AI Trading Engine Environment Configuration Example
# ====================================================
# Copy this file to .env and configure with your actual API keys
# Command: cp .env.example .env

# Webhook API Security (generate with: openssl rand -hex 32)
WEBHOOK_API_KEY=your-secure-webhook-api-key-change-this

# Claude AI Configuration (get from: https://console.anthropic.com/)
CLAUDE_API_KEY=your-claude-api-key-here

# Binance API Configuration (get from: https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=your-binance-api-key-here
BINANCE_API_SECRET=your-binance-api-secret-here

# Telegram Configuration (bot token from @BotFather, chat ID from @userinfobot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Database Configuration (optional)
DB_PASSWORD=root
# DB_URL=jdbc:postgresql://localhost:5432/trading_engine
# DB_USERNAME=postgres

# Redis Configuration (optional)
REDIS_PASSWORD=
# REDIS_URL=localhost

# Trading Configuration (optional)
ACCOUNT_BALANCE=10000

# Application Configuration (optional)
SPRING_PROFILES_ACTIVE=dev
# JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
