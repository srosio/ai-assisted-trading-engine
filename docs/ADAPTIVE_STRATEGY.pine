//@version=6
indicator("Adaptive Multi-Regime Strategy", overlay=true)

// ============================================================================
// STRATEGY: Adaptive Strategy (40-60% WR, 1:2-1:4 R:R)
// Switches between trending, ranging, and volatile regimes automatically
// Webhook-integrated with AI-Assisted Trading Engine
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

// Regime Detection
adxLength = input.int(14, "ADX Length", minval=1)
adxTrendThreshold = input.int(25, "ADX Trend Threshold", minval=15, maxval=40)
bbLength = input.int(20, "BB Length", minval=1)
bbMult = input.float(2.0, "BB StdDev", minval=0.1)

// Volume Settings
volMultiplier = input.float(1.8, "Volume Spike Multiplier", minval=1.0)

// Webhook Settings
webhookUrl = input.string("https://your-app.onrender.com/api/webhook/tradingview?apiKey=YOUR_KEY", "Webhook URL")

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

// ADX for Trend Strength
[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)

// Bollinger Bands for Volatility
[bbMiddle, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)
bbWidth = (bbUpper - bbLower) / bbMiddle

// ATR for Volatility
atr = ta.atr(14)
atrNormalized = atr / close * 100

// Moving Averages
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

// Volume
volSMA = ta.sma(volume, 20)
volumeSpike = volume > volSMA * volMultiplier

// ─────────────────────────────────────────────────────────────────────────────
// REGIME DETECTION
// ─────────────────────────────────────────────────────────────────────────────

// Trending Regime: Strong ADX + aligned MAs
isTrending = adx > adxTrendThreshold
isUptrend = isTrending and ema20 > ema50 and close > ema200
isDowntrend = isTrending and ema20 < ema50 and close < ema200

// Ranging Regime: Weak ADX + narrow BBs
isRanging = adx < adxTrendThreshold and bbWidth < ta.sma(bbWidth, 50)

// Volatile Regime: Wide BBs + high ATR
isVolatile = bbWidth > ta.sma(bbWidth, 50) * 1.5 or atrNormalized > 3.0

// Determine Primary Regime
regime = isUptrend ? "UPTREND" :
         isDowntrend ? "DOWNTREND" :
         isRanging ? "RANGING" :
         isVolatile ? "VOLATILE" : "NEUTRAL"

// Previous Day High/Low
var float pdHigh = na
var float pdLow = na
if ta.change(time('D'))
    pdHigh := high[1]
    pdLow := low[1]

// Session Detection
is_london = hour(time, "America/New_York") >= 3 and hour(time, "America/New_York") < 8
is_ny = hour(time, "America/New_York") >= 8 and hour(time, "America/New_York") < 16
is_asia = hour(time, "America/New_York") >= 20 or hour(time, "America/New_York") < 3

session = is_london ? "LONDON_OPEN" : is_ny ? "NY_OPEN" : is_asia ? "ASIA_OPEN" : "OFF_SESSION"

// HTF Bias (4H timeframe)
htf_ema_fast = request.security(syminfo.tickerid, "240", ta.ema(close, 20))
htf_ema_slow = request.security(syminfo.tickerid, "240", ta.ema(close, 50))
htfBias = htf_ema_fast > htf_ema_slow ? "BULLISH" : htf_ema_fast < htf_ema_slow ? "BEARISH" : "NEUTRAL"

// ─────────────────────────────────────────────────────────────────────────────
// ADAPTIVE STRATEGY LOGIC
// ─────────────────────────────────────────────────────────────────────────────

// TRENDING REGIME: Pullback entries
longTrend = isUptrend and close <= ema20 and close > ema20 * 0.995 and close > open
shortTrend = isDowntrend and close >= ema20 and close < ema20 * 1.005 and close < open

// RANGING REGIME: Mean reversion
longRange = isRanging and close <= bbLower and close > low
shortRange = isRanging and close >= bbUpper and close < high

// VOLATILE REGIME: Momentum breakout
longVolatile = isVolatile and close > bbMiddle and diPlus > diMinus and volumeSpike
shortVolatile = isVolatile and close < bbMiddle and diMinus > diPlus and volumeSpike

// Combined signals
longSignal = (longTrend or longRange or longVolatile) and htfBias != "BEARISH"
shortSignal = (shortTrend or shortRange or shortVolatile) and htfBias != "BULLISH"

// Displacement Detection
candleRange = high - low
avgRange = ta.sma(candleRange, 14)
displacementDetected = candleRange > avgRange * 2.0

// Swept Levels
sweptHigh = high > pdHigh ? pdHigh : na
sweptLow = low < pdLow ? pdLow : na

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING
// ─────────────────────────────────────────────────────────────────────────────

plot(ema20, "EMA 20", color=color.blue, linewidth=2)
plot(ema50, "EMA 50", color=color.orange, linewidth=1)

p1 = plot(bbUpper, "BB Upper", color=color.gray)
p2 = plot(bbLower, "BB Lower", color=color.gray)
fill(p1, p2, color=color.new(color.gray, 95))

// Regime Background
regimeColor = regime == "UPTREND" ? color.new(color.green, 95) :
              regime == "DOWNTREND" ? color.new(color.red, 95) :
              regime == "RANGING" ? color.new(color.blue, 95) :
              regime == "VOLATILE" ? color.new(color.orange, 95) : na
bgcolor(regimeColor)

plotshape(longSignal, "Adaptive Long", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(shortSignal, "Adaptive Short", shape.triangledown, location.abovebar, color.red, size=size.normal)

// Display Regime
var label regimeLabel = na
if barstate.islast
    if not na(regimeLabel)
        label.delete(regimeLabel)
    regimeLabel := label.new(bar_index, high, "Regime: " + regime + "\nADX: " + str.tostring(adx, "#.#"),
                              style=label.style_label_down, color=color.new(color.white, 30))

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS & WEBHOOKS
// ─────────────────────────────────────────────────────────────────────────────

// Long Alert with Regime Context
if longSignal
    eventName = longTrend ? "adaptive_long_trend_pullback" :
                longRange ? "adaptive_long_range_reversal" :
                "adaptive_long_volatile_breakout"

    alert('{"symbol":"' + syminfo.ticker + '", "timeframe":"' + timeframe.period + '", "event":"' + eventName + '", "session":"' + session + '", "price":' + str.tostring(close) + ', "previousDayHigh":' + str.tostring(pdHigh) + ', "previousDayLow":' + str.tostring(pdLow) + ', "volumeSpike":' + str.tostring(volumeSpike) + ', "displacementDetected":' + str.tostring(displacementDetected) + ', "sweptHigh":' + str.tostring(sweptHigh) + ', "sweptLow":' + str.tostring(sweptLow) + ', "htfBias":"' + htfBias + '"}', alert.freq_once_per_bar_close)

// Short Alert with Regime Context
if shortSignal
    eventName = shortTrend ? "adaptive_short_trend_pullback" :
                shortRange ? "adaptive_short_range_reversal" :
                "adaptive_short_volatile_breakout"

    alert('{"symbol":"' + syminfo.ticker + '", "timeframe":"' + timeframe.period + '", "event":"' + eventName + '", "session":"' + session + '", "price":' + str.tostring(close) + ', "previousDayHigh":' + str.tostring(pdHigh) + ', "previousDayLow":' + str.tostring(pdLow) + ', "volumeSpike":' + str.tostring(volumeSpike) + ', "displacementDetected":' + str.tostring(displacementDetected) + ', "sweptHigh":' + str.tostring(sweptHigh) + ', "sweptLow":' + str.tostring(sweptLow) + ', "htfBias":"' + htfBias + '"}', alert.freq_once_per_bar_close)
