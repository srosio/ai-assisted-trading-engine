//@version=6
indicator("Liquidity Sweep Strategy", overlay=true)

// ============================================================================
// STRATEGY: Liquidity Sweep (45-55% WR, 1:3-1:5 R:R)
// Identifies false breakouts and liquidity grabs followed by reversals
// Webhook-integrated with AI-Assisted Trading Engine
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

// Liquidity Level Detection
pivotLookback = input.int(10, "Pivot Lookback", minval=3)
sweepBuffer = input.float(0.1, "Sweep Buffer %", minval=0.01, maxval=0.5, step=0.01)

// Displacement Settings
displaceMultiplier = input.float(1.5, "Displacement ATR Multiplier", minval=1.0)

// Volume Confirmation
volMultiplier = input.float(2.0, "Volume Spike Multiplier", minval=1.0)

// Webhook Settings
webhookUrl = input.string("https://your-app.onrender.com/api/webhook/tradingview?apiKey=YOUR_KEY", "Webhook URL")

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

// Pivot Highs and Lows (Equal Highs/Lows)
pivotHigh = ta.pivothigh(high, pivotLookback, pivotLookback)
pivotLow = ta.pivotlow(low, pivotLookback, pivotLookback)

// Store recent pivot levels
var float lastPivotHigh = na
var float lastPivotLow = na

if not na(pivotHigh)
    lastPivotHigh := pivotHigh

if not na(pivotLow)
    lastPivotLow := pivotLow

// ATR for displacement detection
atr = ta.atr(14)

// Volume
volSMA = ta.sma(volume, 20)
volumeSpike = volume > volSMA * volMultiplier

// Order Flow Imbalance
buyVolume = close > open ? volume : 0
sellVolume = close < open ? volume : 0
obvBuy = ta.cum(buyVolume)
obvSell = ta.cum(sellVolume)

// Previous Day High/Low
var float pdHigh = na
var float pdLow = na
if timeframe.change('D')
    pdHigh := high[1]
    pdLow := low[1]

// Session Detection
currentHour = hour(time, "America/New_York")
is_london = currentHour >= 3 and currentHour < 8
is_ny = currentHour >= 8 and currentHour < 16
is_asia = currentHour >= 20 or currentHour < 3

session = is_london ? "LONDON_OPEN" : is_ny ? "NY_OPEN" : is_asia ? "ASIA_OPEN" : "OFF_SESSION"

// HTF Bias (1H timeframe)
htf_ema_fast = request.security(syminfo.tickerid, "60", ta.ema(close, 20))
htf_ema_slow = request.security(syminfo.tickerid, "60", ta.ema(close, 50))
htfBias = htf_ema_fast > htf_ema_slow ? "BULLISH" : htf_ema_fast < htf_ema_slow ? "BEARISH" : "NEUTRAL"

// ─────────────────────────────────────────────────────────────────────────────
// STRATEGY LOGIC
// ─────────────────────────────────────────────────────────────────────────────

// Liquidity Sweep Detection
sweepThreshold = sweepBuffer / 100

// High Sweep (false breakout above) followed by rejection
highSwept = not na(lastPivotHigh) and high > lastPivotHigh * (1 + sweepThreshold) and close < lastPivotHigh
highSweptConfirmed = highSwept and close < open and volumeSpike

// Displacement reversal (strong move down)
displacementDown = (open - close) > atr * displaceMultiplier

// Short Setup: Swept high + displacement + volume
shortSetup = highSweptConfirmed and displacementDown

// Low Sweep (false breakout below) followed by rejection
lowSwept = not na(lastPivotLow) and low < lastPivotLow * (1 - sweepThreshold) and close > lastPivotLow
lowSweptConfirmed = lowSwept and close > open and volumeSpike

// Displacement reversal (strong move up)
displacementUp = (close - open) > atr * displaceMultiplier

// Long Setup: Swept low + displacement + volume
longSetup = lowSweptConfirmed and displacementUp

// General displacement detection
displacementDetected = displacementUp or displacementDown

// Track swept levels for webhook
var float sweptHighLevel = na
var float sweptLowLevel = na

if highSwept
    sweptHighLevel := lastPivotHigh

if lowSwept
    sweptLowLevel := lastPivotLow

// ─────────────────────────────────────────────────────────────────────────────
// PLOTTING
// ─────────────────────────────────────────────────────────────────────────────

// Plot pivot levels
plot(lastPivotHigh, "Pivot High", color=color.red, linewidth=1, style=plot.style_circles)
plot(lastPivotLow, "Pivot Low", color=color.green, linewidth=1, style=plot.style_circles)

plotshape(longSetup, "Liquidity Sweep Long", shape.triangleup, location.belowbar, color.green, size=size.large)
plotshape(shortSetup, "Liquidity Sweep Short", shape.triangledown, location.abovebar, color.red, size=size.large)

// Highlight sweeps
bgcolor(highSwept ? color.new(color.red, 90) : na)
bgcolor(lowSwept ? color.new(color.green, 90) : na)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS & WEBHOOKS
// ─────────────────────────────────────────────────────────────────────────────

// Long Liquidity Sweep Alert
if longSetup
    alert('{"symbol":"' + syminfo.ticker + '", "timeframe":"' + timeframe.period + '", "event":"liquidity_long_sweep_reversal", "session":"' + session + '", "price":' + str.tostring(close) + ', "previousDayHigh":' + str.tostring(pdHigh) + ', "previousDayLow":' + str.tostring(pdLow) + ', "volumeSpike":' + str.tostring(volumeSpike) + ', "displacementDetected":' + str.tostring(displacementDetected) + ', "sweptHigh":null, "sweptLow":' + str.tostring(sweptLowLevel) + ', "htfBias":"' + htfBias + '"}', alert.freq_once_per_bar_close)

// Short Liquidity Sweep Alert
if shortSetup
    alert('{"symbol":"' + syminfo.ticker + '", "timeframe":"' + timeframe.period + '", "event":"liquidity_short_sweep_reversal", "session":"' + session + '", "price":' + str.tostring(close) + ', "previousDayHigh":' + str.tostring(pdHigh) + ', "previousDayLow":' + str.tostring(pdLow) + ', "volumeSpike":' + str.tostring(volumeSpike) + ', "displacementDetected":' + str.tostring(displacementDetected) + ', "sweptHigh":' + str.tostring(sweptHighLevel) + ', "sweptLow":null, "htfBias":"' + htfBias + '"}', alert.freq_once_per_bar_close)
